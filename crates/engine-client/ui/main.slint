// Root window for the engine-client.

export enum PrimitiveKind {
    path,
    text,
}

export struct ScenePrimitive {
    kind: PrimitiveKind,
    x: length,
    y: length,
    width: length,
    height: length,
    viewbox-width: float,
    viewbox-height: float,
    commands: string,
    fill: brush,
    stroke: brush,
    stroke-width: length,
    text: string,
    color: brush,
    font-size: length,
    text-x: length,
    text-y: length,
}

component ScenePrimitiveItem inherits Rectangle {
    in property <ScenePrimitive> primitive;

    x: primitive.x;
    y: primitive.y;
    width: primitive.width;
    height: primitive.height;
    clip: true;
    background: #00000000;

    Path {
        visible: primitive.kind == PrimitiveKind.path;
        width: parent.width;
        height: parent.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: primitive.viewbox-width;
        viewbox-height: primitive.viewbox-height;
        commands: primitive.commands;
        fill: primitive.fill;
        stroke: primitive.stroke;
        stroke-width: primitive.stroke-width;
    }

    Text {
        visible: primitive.kind == PrimitiveKind.text;
        x: primitive.text-x;
        y: primitive.text-y;
        text: primitive.text;
        color: primitive.color;
        font-size: primitive.font-size;
    }
}

component MinimapPanel inherits Rectangle {
    in property <[ScenePrimitive]> primitives;

    background: #050514;
    clip: true;
    border-radius: self.width / 2;

    for primitive in root.primitives: ScenePrimitiveItem {
        primitive: primitive;
    }
}

component PlayerStatusPanel inherits Rectangle {
    in property <string> player-name;
    in property <string> status-text;
    in property <float> status-fraction;
    in property <brush> player-color;
    in property <bool> align-right: false;

    background: #080a12d8;
    border-color: root.player-color;
    border-width: 1px;

    Text {
        x: 12px;
        y: 8px;
        width: parent.width - 24px;
        height: 20px;
        text: root.player-name + "  ·  " + root.status-text;
        color: root.player-color;
        font-size: 13px;
        horizontal-alignment: root.align-right ? right : left;
    }

    Rectangle {
        x: 12px;
        y: 34px;
        width: parent.width - 24px;
        height: 10px;
        background: #242733;
        border-color: #7d8494;
        border-width: 1px;

        Rectangle {
            x: 1px;
            y: 1px;
            width: (parent.width - 2px) * root.status-fraction;
            height: parent.height - 2px;
            background: root.player-color;
        }
    }
}

component MenuButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback activated();

    background: button-touch.pressed ? #236e96 : root.selected ? #174f70 : #151a27;
    border-color: button-touch.pressed || root.selected ? #80d8ff : #596273;
    border-width: button-touch.pressed || root.selected ? 3px : 1px;
    border-radius: 6px;

    Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        color: button-touch.pressed || root.selected ? #ffffff : #d9e1ec;
        font-size: 16px;
        font-weight: button-touch.pressed || root.selected ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

component ChoiceRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> selected: false;
    callback previous();
    callback next();

    background: root.selected ? #122f44 : #10141f;
    border-color: root.selected ? #80d8ff : #424a5a;
    border-width: root.selected ? 3px : 1px;
    border-radius: 6px;

    Text {
        x: 14px;
        width: parent.width * 0.38;
        height: parent.height;
        text: root.label;
        color: #c7d0dc;
        font-size: 14px;
        vertical-alignment: center;
    }

    MenuButton {
        x: parent.width * 0.40;
        y: 2px;
        width: 52px;
        height: parent.height - 4px;
        text: "‹";
        activated => {
            root.previous();
        }
    }

    Text {
        x: parent.width * 0.40 + 60px;
        width: parent.width * 0.60 - 120px;
        height: parent.height;
        text: root.value;
        color: #ffffff;
        font-size: 15px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    MenuButton {
        x: parent.width - 54px;
        y: 2px;
        width: 52px;
        height: parent.height - 4px;
        text: "›";
        activated => {
            root.next();
        }
    }
}

component TouchTestTarget inherits Rectangle {
    in property <string> text;
    in property <bool> hit: false;
    in property <brush> idle-background;
    in property <brush> idle-border;

    background: root.hit ? #155b3a : root.idle-background;
    border-color: root.hit ? #7dffb2 : root.idle-border;
    border-width: 4px;
    border-radius: 12px;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: #ffffff;
        font-size: 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component MainWindow inherits Window {
    in property <bool> app-full-screen: false;
    in property <[ScenePrimitive]> primitives;
    in property <[ScenePrimitive]> p1-minimap-primitives;
    in property <[ScenePrimitive]> p2-minimap-primitives;
    in property <bool> vector-minimaps-visible: false;
    in property <float> minimap-opacity: 0.74;
    in property <length> p1-minimap-x: 0px;
    in property <length> p1-minimap-y: 0px;
    in property <length> p1-minimap-size: 0px;
    in property <length> p2-minimap-x: 0px;
    in property <length> p2-minimap-y: 0px;
    in property <length> p2-minimap-size: 0px;
    in property <bool> raster-visible: false;
    in property <image> raster-frame;
    in property <bool> native-video-visible: false;
    in property <image> native-video-frame;
    in property <int> native-video-crop-x: 0;
    in property <int> native-video-crop-y: 0;
    in property <int> native-video-crop-width: 0;
    in property <int> native-video-crop-height: 0;
    in property <bool> scenario-pointer-enabled: false;
    in property <bool> scenario-captures-gamepad-start: false;
    in property <bool> scenario-captures-gamepad-select: false;
    in property <string> scenario-error-text: "";
    in-out property <string> runtime-diagnostics: "No active scenario diagnostics.";
    in-out property <bool> launcher-visible: false;
    in-out property <bool> launcher-controls-visible: false;
    in-out property <bool> launcher-settings-visible: false;
    in-out property <int> launcher-focus-index: 0;
    in-out property <int> launcher-controls-focus-index: 0;
    in-out property <int> launcher-settings-focus-index: 0;
    in-out property <bool> touch-test-visible: false;
    in-out property <bool> touch-test-top-left-hit: false;
    in-out property <bool> touch-test-top-right-hit: false;
    in-out property <bool> touch-test-bottom-left-hit: false;
    in-out property <bool> touch-test-bottom-right-hit: false;
    in-out property <float> touch-test-x: 0;
    in-out property <float> touch-test-y: 0;
    in-out property <int> touch-test-count: 0;
    in-out property <string> touch-test-phase: "waiting";
    in-out property <bool> ingame-menu-visible: false;
    in-out property <bool> ingame-controls-visible: false;
    in-out property <int> ingame-menu-focus-index: 0;
    in-out property <bool> game-over-visible: false;
    in-out property <int> game-over-focus-index: 0;
    in property <[string]> launcher-scenarios;
    in-out property <string> launcher-scenario: "spacewars";
    in-out property <string> launcher-seed-text: "0";
    in-out property <string> launcher-renderer: "vector";
    in-out property <string> launcher-raster-scale-text: "1.0";
    in-out property <string> launcher-spacewars-preset: "Original";
    in-out property <string> launcher-universe-radius-text: "1200";
    in-out property <string> launcher-use-planets: "on";
    in-out property <string> launcher-asteroids-enabled: "on";
    in-out property <string> launcher-asteroid-probability-text: "20.0";
    in-out property <string> launcher-player-health-text: "100";
    in-out property <string> launcher-p2-controller: "human";
    in-out property <string> launcher-p1-zoom-text: "320";
    in-out property <string> launcher-p2-zoom-text: "320";
    in-out property <string> launcher-pizza-desired-balls-text: "24";
    in-out property <string> launcher-pizza-spawn-rate-text: "0.10";
    in-out property <string> launcher-clock-time-format: "24-hour";
    in-out property <string> launcher-nes-rom-id: "";
    in-out property <string> launcher-nes-rom-name: "No cartridges found";
    in-out property <string> launcher-nes-rom-status: "Copy a .nes file into the ROM library.";
    in property <string> launcher-nes-rom-directory: "";
    in property <bool> launcher-nes-rom-supported: false;
    in property <string> launcher-error-text: "";
    in property <bool> scenario-benchmark-available: false;
    in property <bool> scenario-player-zoom-available: false;
    in property <string> scenario-controls-help: "";
    in property <string> p1-input-binding: "P1 ⌨";
    in property <string> p2-input-binding: "P2 ⌨";
    in-out property <bool> controller-disconnected-visible: false;
    in-out property <string> controller-disconnected-text: "";
    in property <bool> spacewars-ui-visible: false;
    in property <string> p1-name: "";
    in property <string> p1-status: "";
    in property <float> p1-status-fraction: 0;
    in property <brush> p1-color: #ff0000;
    in property <string> p2-name: "";
    in property <string> p2-status: "";
    in property <float> p2-status-fraction: 0;
    in property <brush> p2-color: #00ff00;
    in property <string> planet-score-label: "";
    in property <float> p1-planet-fraction: 0;
    in property <float> p2-planet-fraction: 0;
    in property <string> p1-planet-score-text: "";
    in property <string> free-planet-score-text: "";
    in property <string> p2-planet-score-text: "";
    in property <string> spacewars-message-text: "";
    in property <string> spacewars-performance-text: "";

    callback launcher-start-game();
    callback launcher-start-benchmark();
    callback launcher-apply-preset();
    callback launcher-p1-zoom-in();
    callback launcher-p1-zoom-out();
    callback launcher-p2-zoom-in();
    callback launcher-p2-zoom-out();
    callback launcher-scenario-selected(string);
    callback launcher-nes-rom-cycle(int);
    callback launcher-quit();
    callback ingame-resume();
    callback ingame-restart();
    callback ingame-return-launcher();
    callback ingame-start-benchmark();
    callback ingame-p1-zoom-in();
    callback ingame-p1-zoom-out();
    callback ingame-p2-zoom-in();
    callback ingame-p2-zoom-out();
    callback scenario-pointer(float, float, int);
    callback native-video-ready();
    callback ui-action(int);

    forward-focus: launcher-shortcuts;

    changed launcher-visible => {
        if (root.launcher-visible) {
            launcher-shortcuts.focus();
        }
    }

    changed launcher-controls-visible => {
        if (root.launcher-visible) {
            if (root.launcher-controls-visible) {
                root.launcher-controls-focus-index = 0;
            }
            launcher-shortcuts.focus();
        }
    }

    changed launcher-settings-visible => {
        if (root.launcher-visible) {
            launcher-shortcuts.focus();
        }
    }

    changed touch-test-visible => {
        if (root.touch-test-visible) {
            root.touch-test-top-left-hit = false;
            root.touch-test-top-right-hit = false;
            root.touch-test-bottom-left-hit = false;
            root.touch-test-bottom-right-hit = false;
            root.touch-test-x = root.width / 2 / 1px;
            root.touch-test-y = root.height / 2 / 1px;
            root.touch-test-count = 0;
            root.touch-test-phase = "waiting";
            launcher-shortcuts.focus();
        }
    }

    changed ingame-menu-visible => {
        if (root.ingame-menu-visible) {
            root.ingame-menu-focus-index = 0;
        }
    }

    changed game-over-visible => {
        if (root.game-over-visible) {
            root.game-over-focus-index = 0;
        }
    }

    title: "Space-Wars";
    full-screen: root.app-full-screen;
    preferred-width: 1280px;
    preferred-height: 720px;
    background: #050514;

    Image {
        visible: root.raster-visible;
        width: parent.width;
        height: parent.height;
        source: root.raster-frame;
    }

    Image {
        visible: root.native-video-visible;
        width: parent.width;
        height: parent.height;
        source: root.native-video-frame;
        source-clip-x: root.native-video-crop-x;
        source-clip-y: root.native-video-crop-y;
        source-clip-width: root.native-video-crop-width;
        source-clip-height: root.native-video-crop-height;
        image-fit: contain;
        image-rendering: pixelated;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    for primitive in root.primitives: ScenePrimitiveItem {
        primitive: primitive;
    }

    MinimapPanel {
        visible: root.vector-minimaps-visible;
        x: root.p1-minimap-x;
        y: root.p1-minimap-y;
        width: root.p1-minimap-size;
        height: root.p1-minimap-size;
        // Group opacity makes Slint composite the backdrop and all primitives once.
        opacity: root.minimap-opacity;
        primitives: root.p1-minimap-primitives;
    }

    MinimapPanel {
        visible: root.vector-minimaps-visible;
        x: root.p2-minimap-x;
        y: root.p2-minimap-y;
        width: root.p2-minimap-size;
        height: root.p2-minimap-size;
        opacity: root.minimap-opacity;
        primitives: root.p2-minimap-primitives;
    }

    scenario-pointer-area := TouchArea {
        enabled: root.scenario-pointer-enabled
            && !root.launcher-visible
            && !root.ingame-menu-visible
            && !root.game-over-visible;
        width: parent.width;
        height: parent.height;
        mouse-cursor: crosshair;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.cancel) {
                root.scenario-pointer(self.mouse-x / 1px, self.mouse-y / 1px, 3);
                return;
            }
            if (event.button != PointerEventButton.left) {
                return;
            }
            if (event.kind == PointerEventKind.down) {
                root.scenario-pointer(self.mouse-x / 1px, self.mouse-y / 1px, 0);
            } else if (event.kind == PointerEventKind.up) {
                root.scenario-pointer(self.mouse-x / 1px, self.mouse-y / 1px, 2);
            }
        }

        moved => {
            if (self.pressed) {
                root.scenario-pointer(self.mouse-x / 1px, self.mouse-y / 1px, 1);
            }
        }
    }

    Rectangle {
        visible: root.spacewars-ui-visible;
        x: root.width / 2 - 1px;
        width: 2px;
        height: root.height;
        background: #59627388;
    }

    PlayerStatusPanel {
        visible: root.spacewars-ui-visible;
        x: 16px;
        y: 16px;
        width: root.width * 0.31;
        height: 54px;
        player-name: root.p1-name;
        status-text: root.p1-status;
        status-fraction: root.p1-status-fraction;
        player-color: root.p1-color;
    }

    PlayerStatusPanel {
        visible: root.spacewars-ui-visible;
        x: root.width - self.width - 16px;
        y: 16px;
        width: root.width * 0.31;
        height: 54px;
        player-name: root.p2-name;
        status-text: root.p2-status;
        status-fraction: root.p2-status-fraction;
        player-color: root.p2-color;
        align-right: true;
    }

    Rectangle {
        visible: root.spacewars-ui-visible;
        x: root.width * 0.37;
        y: root.height - self.height - 14px;
        width: root.width * 0.26;
        height: 82px;
        background: #080a12d0;
        border-color: #596273aa;
        border-width: 1px;

        Text {
            x: 10px;
            y: 6px;
            width: parent.width - 20px;
            height: 18px;
            text: root.planet-score-label;
            color: #e6edf7;
            font-size: 12px;
            horizontal-alignment: center;
        }

        Rectangle {
            x: 10px;
            y: 27px;
            width: parent.width - 20px;
            height: 12px;
            background: #666b76;
            border-color: #a0a6b2;
            border-width: 1px;

            Rectangle {
                x: 1px;
                y: 1px;
                width: (parent.width - 2px) * root.p1-planet-fraction;
                height: parent.height - 2px;
                background: root.p1-color;
            }

            Rectangle {
                y: 1px;
                width: (parent.width - 2px) * root.p2-planet-fraction;
                x: parent.width - self.width - 1px;
                height: parent.height - 2px;
                background: root.p2-color;
            }

            Text {
                x: 1px;
                y: 0px;
                width: (parent.width - 2px) * root.p1-planet-fraction;
                height: parent.height;
                text: root.p1-planet-score-text;
                color: #050514;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Text {
                x: 1px + (parent.width - 2px) * root.p1-planet-fraction;
                y: 0px;
                width: (parent.width - 2px) * (1.0 - root.p1-planet-fraction - root.p2-planet-fraction);
                height: parent.height;
                text: root.free-planet-score-text;
                color: #050514;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Text {
                y: 0px;
                width: (parent.width - 2px) * root.p2-planet-fraction;
                x: parent.width - self.width - 1px;
                height: parent.height;
                text: root.p2-planet-score-text;
                color: #050514;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            x: 8px;
            y: 44px;
            width: parent.width - 16px;
            height: 17px;
            text: root.spacewars-message-text;
            color: #f6f2a6;
            font-size: 11px;
            horizontal-alignment: center;
        }

        Text {
            x: 8px;
            y: 62px;
            width: parent.width - 16px;
            height: 14px;
            text: root.spacewars-performance-text;
            color: #c7d0dc;
            font-size: 9px;
            horizontal-alignment: center;
        }
    }

    Rectangle {
        visible: root.ingame-menu-visible;
        width: parent.width;
        height: parent.height;
        background: #050514cc;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.width < 632px ? root.width - 32px : 600px;
            height: root.ingame-controls-visible ? (root.height < 456px ? root.height - 24px : 432px) : 326px;
            background: #080a12f7;
            border-color: #596273;
            border-width: 1px;
            border-radius: 8px;

            Text {
                x: 24px;
                y: 18px;
                text: root.ingame-controls-visible ? "Controls" : "Paused";
                color: #ffffff;
                font-size: 26px;
                font-weight: 700;
            }

            Text {
                visible: !root.ingame-controls-visible;
                x: 24px;
                y: 54px;
                width: parent.width - 48px;
                text: "Tap a choice  ·  D-pad chooses  ·  A selects  ·  B or Start resumes";
                color: #80d8ff;
                font-size: 14px;
                horizontal-alignment: center;
            }

            MenuButton {
                visible: !root.ingame-controls-visible;
                x: 24px;
                y: 84px;
                width: (parent.width - 58px) / 2;
                height: 54px;
                text: "Resume";
                selected: root.ingame-menu-focus-index == 0;
                activated => {
                    root.ingame-menu-focus-index = 0;
                    root.ingame-resume();
                }
            }

            MenuButton {
                visible: !root.ingame-controls-visible;
                x: parent.width / 2 + 5px;
                y: 84px;
                width: (parent.width - 58px) / 2;
                height: 54px;
                text: "Restart Round";
                selected: root.ingame-menu-focus-index == 1;
                activated => {
                    root.ingame-menu-focus-index = 1;
                    root.ingame-restart();
                }
            }

            MenuButton {
                visible: !root.ingame-controls-visible && root.scenario-benchmark-available;
                x: 24px;
                y: 148px;
                width: (parent.width - 58px) / 2;
                height: 54px;
                text: "Benchmark";
                selected: root.ingame-menu-focus-index == 2;
                activated => {
                    root.ingame-menu-focus-index = 2;
                    root.ingame-start-benchmark();
                }
            }

            MenuButton {
                visible: !root.ingame-controls-visible;
                x: root.scenario-benchmark-available ? parent.width / 2 + 5px : 24px;
                y: 148px;
                width: (parent.width - 58px) / 2;
                height: 54px;
                text: "Controls";
                selected: root.ingame-menu-focus-index == (root.scenario-benchmark-available ? 3 : 2);
                activated => {
                    root.ingame-menu-focus-index = root.scenario-benchmark-available ? 3 : 2;
                    root.ingame-controls-visible = true;
                }
            }

            MenuButton {
                visible: !root.ingame-controls-visible;
                x: root.scenario-benchmark-available ? 24px : parent.width / 2 + 5px;
                y: root.scenario-benchmark-available ? 212px : 148px;
                width: root.scenario-benchmark-available ? parent.width - 48px : (parent.width - 58px) / 2;
                height: 54px;
                text: "Return to Launcher";
                selected: root.ingame-menu-focus-index == (root.scenario-benchmark-available ? 4 : 3);
                activated => {
                    root.ingame-menu-focus-index = root.scenario-benchmark-available ? 4 : 3;
                    root.ingame-return-launcher();
                }
            }

            Rectangle {
                visible: root.ingame-controls-visible;
                x: 24px;
                y: 62px;
                width: parent.width - 48px;
                height: parent.height - 132px;
                background: #10141f;
                border-color: #424a5a;
                border-width: 1px;
                border-radius: 6px;

                Text {
                    x: 16px;
                    y: 12px;
                    width: parent.width - 32px;
                    height: 145px;
                    text: root.scenario-controls-help;
                    color: #e6edf7;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                Text {
                    x: 16px;
                    y: 160px;
                    width: parent.width - 32px;
                    height: 80px;
                    text: "Controller menus: D-pad or left stick navigates, A selects, B goes back, Start resumes. Disconnecting a controller pauses the round.";
                    color: #80d8ff;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                Text {
                    x: 16px;
                    y: 238px;
                    width: parent.width - 32px;
                    height: 52px;
                    text: "Keyboard: P/Esc pause, R restart, " + (root.scenario-benchmark-available ? "B benchmark, " : "") + "Q launcher, C/F1 controls.";
                    color: #c7d0dc;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            MenuButton {
                visible: root.ingame-controls-visible;
                x: 24px;
                y: parent.height - 58px;
                width: 150px;
                height: 44px;
                text: "Back";
                selected: true;
                activated => {
                    root.ingame-controls-visible = false;
                }
            }

            MenuButton {
                visible: root.ingame-controls-visible;
                x: parent.width - 174px;
                y: parent.height - 58px;
                width: 150px;
                height: 44px;
                text: "Resume";
                activated => {
                    root.ingame-resume();
                }
            }
        }
    }

    Rectangle {
        visible: root.game-over-visible && !root.launcher-visible;
        width: parent.width;
