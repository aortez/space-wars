            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text: root.controller-disconnected-text;
            color: #ffe7ea;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        visible: root.scenario-error-text != "" && !root.launcher-visible;
        x: root.width * 0.15;
        y: root.controller-disconnected-visible ? 72px : 16px;
        width: root.width * 0.70;
        height: 48px;
        background: #24080df0;
        border-color: #ff7184;
        border-width: 2px;
        border-radius: 6px;

        Text {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text: root.scenario-error-text;
            color: #ffe5e9;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    Rectangle {
        visible: root.touch-test-visible;
        width: parent.width;
        height: parent.height;
        background: #050514;

        touch-test-area := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: crosshair;

            pointer-event(event) => {
                root.touch-test-x = self.mouse-x / 1px;
                root.touch-test-y = self.mouse-y / 1px;
                if (event.kind == PointerEventKind.down) {
                    root.touch-test-count += 1;
                    root.touch-test-phase = "down";
                } else if (event.kind == PointerEventKind.move) {
                    root.touch-test-phase = "move";
                } else if (event.kind == PointerEventKind.up) {
                    root.touch-test-phase = "up";
                } else if (event.kind == PointerEventKind.cancel) {
                    root.touch-test-phase = "cancel";
                }
            }

            clicked => {
                if (self.mouse-x > root.width / 2 - 100px && self.mouse-x < root.width / 2 + 100px
                    && self.mouse-y > root.height - 74px) {
                    root.touch-test-visible = false;
                } else if (self.mouse-x < 148px && self.mouse-y < 148px) {
                    root.touch-test-top-left-hit = true;
                } else if (self.mouse-x > root.width - 148px && self.mouse-y < 148px) {
                    root.touch-test-top-right-hit = true;
                } else if (self.mouse-x < 148px && self.mouse-y > root.height - 148px) {
                    root.touch-test-bottom-left-hit = true;
                } else if (self.mouse-x > root.width - 148px && self.mouse-y > root.height - 148px) {
                    root.touch-test-bottom-right-hit = true;
                }
            }
        }

        Text {
            x: 150px;
            y: 16px;
            width: parent.width - 300px;
            height: 80px;
            text: root.touch-test-top-left-hit && root.touch-test-top-right-hit
                && root.touch-test-bottom-left-hit && root.touch-test-bottom-right-hit
                ? "TOUCHSCREEN TEST\nAll four targets matched. Touch and display orientation agree."
                : "TOUCHSCREEN TEST\nTap targets 1–4 clockwise. The crosshair should stay beneath your finger.";
            color: root.touch-test-top-left-hit && root.touch-test-top-right-hit
                && root.touch-test-bottom-left-hit && root.touch-test-bottom-right-hit
                ? #7dffb2 : #c7d0dc;
            font-size: 15px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        TouchTestTarget {
            x: 20px;
            y: 20px;
            width: 112px;
            height: 112px;
            text: "1\nTOP\nLEFT";
            hit: root.touch-test-top-left-hit;
            idle-background: #3a2038;
            idle-border: #ff8ce6;
        }

        TouchTestTarget {
            x: parent.width - 132px;
            y: 20px;
            width: 112px;
            height: 112px;
            text: "2\nTOP\nRIGHT";
            hit: root.touch-test-top-right-hit;
            idle-background: #20384d;
            idle-border: #80d8ff;
        }

        TouchTestTarget {
            x: parent.width - 132px;
            y: parent.height - 132px;
            width: 112px;
            height: 112px;
            text: "3\nBOTTOM\nRIGHT";
            hit: root.touch-test-bottom-right-hit;
            idle-background: #49361d;
            idle-border: #ffd166;
        }

        TouchTestTarget {
            x: 20px;
            y: parent.height - 132px;
            width: 112px;
            height: 112px;
            text: "4\nBOTTOM\nLEFT";
            hit: root.touch-test-bottom-left-hit;
            idle-background: #253d28;
            idle-border: #9cff9c;
        }

        Rectangle {
            visible: root.touch-test-count > 0;
            x: root.touch-test-x * 1px - 14px;
            y: root.touch-test-y * 1px - 14px;
            width: 28px;
            height: 28px;
            background: #00000000;
            border-color: root.touch-test-phase == "down" ? #ff7184 : #ffffff;
            border-width: 4px;
            border-radius: 14px;
        }

        Text {
            x: 150px;
            y: parent.height / 2 - 26px;
            width: parent.width - 300px;
            height: 52px;
            text: "Touches " + root.touch-test-count + "  ·  x " + Math.round(root.touch-test-x)
                + "  ·  y " + Math.round(root.touch-test-y) + "  ·  " + root.touch-test-phase;
            color: #80d8ff;
            font-size: 18px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - 68px;
            width: 200px;
            height: 52px;
            background: #174f70;
            border-color: #80d8ff;
            border-width: 2px;
            border-radius: 8px;

            Text {
                width: parent.width;
                height: parent.height;
                text: "Done  ·  Esc / B";
                color: #ffffff;
                font-size: 16px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

}
