// Root window for the engine-client.

import { Button, ComboBox, LineEdit } from "std-widgets.slint";

export enum PrimitiveKind {
    path,
    text,
}

export struct ScenePrimitive {
    kind: PrimitiveKind,
    x: length,
    y: length,
    width: length,
    height: length,
    viewbox-width: float,
    viewbox-height: float,
    commands: string,
    fill: brush,
    stroke: brush,
    stroke-width: length,
    text: string,
    color: brush,
    font-size: length,
    text-x: length,
    text-y: length,
}

component ScenePrimitiveItem inherits Rectangle {
    in property <ScenePrimitive> primitive;

    x: primitive.x;
    y: primitive.y;
    width: primitive.width;
    height: primitive.height;
    clip: true;
    background: #00000000;

    Path {
        visible: primitive.kind == PrimitiveKind.path;
        width: parent.width;
        height: parent.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: primitive.viewbox-width;
        viewbox-height: primitive.viewbox-height;
        commands: primitive.commands;
        fill: primitive.fill;
        stroke: primitive.stroke;
        stroke-width: primitive.stroke-width;
    }

    Text {
        visible: primitive.kind == PrimitiveKind.text;
        x: primitive.text-x;
        y: primitive.text-y;
        text: primitive.text;
        color: primitive.color;
        font-size: primitive.font-size;
    }
}

component PlayerStatusPanel inherits Rectangle {
    in property <string> player-name;
    in property <string> status-text;
    in property <float> status-fraction;
    in property <brush> player-color;

    background: #00000000;

    Text {
        x: 0px;
        y: 0px;
        text: root.player-name;
        color: root.player-color;
        font-size: 14px;
    }

    Text {
        x: 0px;
        y: 20px;
        text: root.status-text;
        color: #e6edf7;
        font-size: 12px;
    }

    Rectangle {
        x: 0px;
        y: 40px;
        width: parent.width;
        height: 8px;
        background: #242733;
        border-color: #7d8494;
        border-width: 1px;

        Rectangle {
            x: 1px;
            y: 1px;
            width: (parent.width - 2px) * root.status-fraction;
            height: parent.height - 2px;
            background: root.player-color;
        }
    }
}

export component MainWindow inherits Window {
    in property <[ScenePrimitive]> primitives;
    in property <bool> raster-visible: false;
    in property <image> raster-frame;
    in-out property <bool> launcher-visible: false;
    in-out property <bool> launcher-controls-visible: false;
    in-out property <bool> ingame-menu-visible: false;
    in-out property <bool> ingame-controls-visible: false;
    in-out property <string> launcher-scenario: "spacewars";
    in-out property <string> launcher-seed-text: "0";
    in-out property <string> launcher-renderer: "vector";
    in-out property <string> launcher-raster-scale-text: "1.0";
    in-out property <string> launcher-universe-radius-text: "1200";
    in-out property <string> launcher-use-planets: "on";
    in-out property <string> launcher-asteroids-enabled: "on";
    in-out property <string> launcher-asteroid-probability-text: "20.0";
    in-out property <string> launcher-player-health-text: "100";
    in property <string> launcher-error-text: "";
    in property <bool> spacewars-ui-visible: false;
    in property <string> p1-name: "";
    in property <string> p1-status: "";
    in property <float> p1-status-fraction: 0;
    in property <brush> p1-color: #ff0000;
    in property <string> p2-name: "";
    in property <string> p2-status: "";
    in property <float> p2-status-fraction: 0;
    in property <brush> p2-color: #00ff00;
    in property <string> planet-score-label: "";
    in property <float> p1-planet-fraction: 0;
    in property <float> p2-planet-fraction: 0;
    in property <string> p1-planet-score-text: "";
    in property <string> free-planet-score-text: "";
    in property <string> p2-planet-score-text: "";
    in property <string> spacewars-message-text: "";
    in property <string> spacewars-performance-text: "";

    callback launcher-start-game();
    callback launcher-start-benchmark();
    callback launcher-quit();
    callback ingame-resume();
    callback ingame-restart();
    callback ingame-return-launcher();
    callback ingame-start-benchmark();

    title: "Space-Wars";
    preferred-width: 1280px;
    preferred-height: 720px;
    background: #050514;

    Image {
        visible: root.raster-visible;
        width: parent.width;
        height: parent.height;
        source: root.raster-frame;
    }

    for primitive in root.primitives: ScenePrimitiveItem {
        primitive: primitive;
    }

    Rectangle {
        visible: root.spacewars-ui-visible;
        x: root.width * 0.36;
        y: root.height * 0.58;
        width: root.width * 0.28;
        height: root.height * 0.42;
        background: #080a12dd;
        border-color: #596273;
        border-width: 1px;

        PlayerStatusPanel {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: 54px;
            player-name: root.p1-name;
            status-text: root.p1-status;
            status-fraction: root.p1-status-fraction;
            player-color: root.p1-color;
        }

        PlayerStatusPanel {
            x: 12px;
            y: 74px;
            width: parent.width - 24px;
            height: 54px;
            player-name: root.p2-name;
            status-text: root.p2-status;
            status-fraction: root.p2-status-fraction;
            player-color: root.p2-color;
        }

        Text {
            x: 12px;
            y: 142px;
            text: root.planet-score-label;
            color: #e6edf7;
            font-size: 12px;
        }

        Rectangle {
            x: 12px;
            y: 164px;
            width: parent.width - 24px;
            height: 12px;
            background: #666b76;
            border-color: #a0a6b2;
            border-width: 1px;

            Rectangle {
                x: 1px;
                y: 1px;
                width: (parent.width - 2px) * root.p1-planet-fraction;
                height: parent.height - 2px;
                background: root.p1-color;
            }

            Rectangle {
                y: 1px;
                width: (parent.width - 2px) * root.p2-planet-fraction;
                x: parent.width - self.width - 1px;
                height: parent.height - 2px;
                background: root.p2-color;
            }

            Text {
                x: 1px;
                y: 0px;
                width: (parent.width - 2px) * root.p1-planet-fraction;
                height: parent.height;
                text: root.p1-planet-score-text;
                color: #050514;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Text {
                x: 1px + (parent.width - 2px) * root.p1-planet-fraction;
                y: 0px;
                width: (parent.width - 2px) * (1.0 - root.p1-planet-fraction - root.p2-planet-fraction);
                height: parent.height;
                text: root.free-planet-score-text;
                color: #050514;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Text {
                y: 0px;
                width: (parent.width - 2px) * root.p2-planet-fraction;
                x: parent.width - self.width - 1px;
                height: parent.height;
                text: root.p2-planet-score-text;
                color: #050514;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            x: 12px;
            y: 194px;
            text: root.spacewars-message-text;
            color: #f6f2a6;
            font-size: 16px;
        }

        Text {
            x: 12px;
            y: 220px;
            text: root.spacewars-performance-text;
            color: #c7d0dc;
            font-size: 12px;
        }
    }

    Rectangle {
        visible: root.ingame-menu-visible;
        width: parent.width;
        height: parent.height;
        background: #050514bb;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 500px;
            height: root.ingame-controls-visible ? 430px : 310px;
            background: #080a12f2;
            border-color: #596273;
            border-width: 1px;

            Text {
                x: 24px;
                y: 22px;
                text: root.ingame-controls-visible ? "Controls" : "Paused";
                color: #e6edf7;
                font-size: 24px;
            }

            Text {
                visible: !root.ingame-controls-visible;
                x: 24px;
                y: 66px;
                width: parent.width - 48px;
                text: "P resumes from the keyboard.";
                color: #c7d0dc;
                font-size: 13px;
            }

            Rectangle {
                visible: root.ingame-controls-visible;
                x: 24px;
                y: 74px;
                width: parent.width - 48px;
                height: 250px;
                background: #00000000;

                Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    text: "Player 1: W thrust, S reverse, A/D turn, J wings, Space laser, K cannon";
                    color: #e6edf7;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                Text {
                    x: 0px;
                    y: 54px;
                    width: parent.width;
                    text: "Player 2: Numpad 8 thrust, Numpad 5 reverse, Numpad 4/6 turn, PageDown wings, Delete laser, End cannon";
                    color: #e6edf7;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                Text {
                    x: 0px;
                    y: 126px;
                    width: parent.width;
                    text: "Global: P pause, R restart, B benchmark. Losing window focus clears held keys.";
                    color: #c7d0dc;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }

            Button {
                visible: !root.ingame-controls-visible;
                x: 24px;
                y: 106px;
                width: 140px;
                height: 36px;
                text: "Resume";
                primary: true;
                clicked => {
                    root.ingame-resume();
                }
            }

            Button {
                visible: !root.ingame-controls-visible;
                x: 174px;
                y: 106px;
                width: 140px;
                height: 36px;
                text: "Restart";
                clicked => {
                    root.ingame-restart();
                }
            }

            Button {
                visible: !root.ingame-controls-visible;
                x: 324px;
                y: 106px;
                width: 152px;
                height: 36px;
                text: "Benchmark";
                clicked => {
                    root.ingame-start-benchmark();
                }
            }

            Button {
                visible: !root.ingame-controls-visible;
                x: 24px;
                y: 158px;
                width: 216px;
                height: 36px;
                text: "Return to Launcher";
                clicked => {
                    root.ingame-return-launcher();
                }
            }

            Button {
                visible: !root.ingame-controls-visible;
                x: 260px;
                y: 158px;
                width: 216px;
                height: 36px;
                text: "Controls";
                clicked => {
                    root.ingame-controls-visible = true;
                }
            }

            Button {
                visible: root.ingame-controls-visible;
                x: 24px;
                y: 350px;
                width: 140px;
                height: 36px;
                text: "Back";
                clicked => {
                    root.ingame-controls-visible = false;
                }
            }

            Button {
                visible: root.ingame-controls-visible;
                x: parent.width - 164px;
                y: 350px;
                width: 140px;
                height: 36px;
                text: "Resume";
                primary: true;
                clicked => {
                    root.ingame-resume();
                }
            }
        }
    }

    Rectangle {
        visible: root.launcher-visible;
        width: parent.width;
        height: parent.height;
        background: #050514f4;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 500px;
            height: root.launcher-controls-visible ? 540px : 640px;
            background: #080a12f2;
            border-color: #596273;
            border-width: 1px;

            Text {
                x: 24px;
                y: 22px;
                text: "Space-Wars";
                color: #e6edf7;
                font-size: 28px;
            }

            Text {
                x: 24px;
                y: 62px;
                text: root.launcher-controls-visible ? "Controls" : "Launch";
                color: #c7d0dc;
                font-size: 14px;
            }

            Rectangle {
                visible: !root.launcher-controls-visible;
                x: 24px;
                y: 96px;
                width: parent.width - 48px;
                height: 418px;
                background: #00000000;

                Text {
                    x: 0px;
                    y: 5px;
                    text: "Scenario";
                    color: #c7d0dc;
                    font-size: 13px;
                }

                ComboBox {
                    x: 160px;
                    y: 0px;
                    width: parent.width - 160px;
                    height: 34px;
                    model: ["spacewars", "null"];
                    current-value <=> root.launcher-scenario;
                }

                Text {
                    x: 0px;
                    y: 55px;
                    text: "Seed";
                    color: #c7d0dc;
                    font-size: 13px;
                }

                LineEdit {
                    x: 160px;
                    y: 48px;
                    width: parent.width - 160px;
                    height: 34px;
                    text <=> root.launcher-seed-text;
                    placeholder-text: "0";
                    accepted => {
                        root.launcher-start-game();
                    }
                }

                Text {
                    x: 0px;
                    y: 103px;
                    text: "Renderer";
                    color: #c7d0dc;
                    font-size: 13px;
                }

                ComboBox {
                    x: 160px;
                    y: 96px;
                    width: parent.width - 160px;
                    height: 34px;
                    model: ["vector", "raster"];
                    current-value <=> root.launcher-renderer;
                }

                Text {
                    x: 0px;
                    y: 151px;
                    text: "Raster Scale";
                    color: #c7d0dc;
                    font-size: 13px;
                }

                ComboBox {
                    x: 160px;
                    y: 144px;
                    width: parent.width - 160px;
                    height: 34px;
                    model: ["1.0", "1.5", "2.0", "3.0"];
                    current-value <=> root.launcher-raster-scale-text;
                }

                Text {
                    x: 0px;
                    y: 204px;
                    text: "Game Setup";
                    color: #e6edf7;
                    font-size: 13px;
                }

                Text {
                    x: 0px;
                    y: 247px;
                    text: "World Radius";
                    color: #c7d0dc;
                    font-size: 13px;
                }

                LineEdit {
                    x: 160px;
                    y: 240px;
                    width: parent.width - 160px;
                    height: 34px;
                    text <=> root.launcher-universe-radius-text;
                    placeholder-text: "1200";
                    accepted => {
                        root.launcher-start-game();
                    }
                }

                Text {
                    x: 0px;
                    y: 295px;
                    text: "Planets";
                    color: #c7d0dc;
                    font-size: 13px;
                }

                ComboBox {
                    x: 160px;
                    y: 288px;
                    width: 118px;
                    height: 34px;
                    model: ["on", "off"];
                    current-value <=> root.launcher-use-planets;
                }

                Text {
                    x: 300px;
                    y: 295px;
                    text: "Asteroids";
                    color: #c7d0dc;
                    font-size: 13px;
                }

                ComboBox {
                    x: 380px;
                    y: 288px;
                    width: parent.width - 380px;
                    height: 34px;
                    model: ["on", "off"];
                    current-value <=> root.launcher-asteroids-enabled;
                }

                Text {
                    x: 0px;
                    y: 343px;
                    text: "Asteroid Rate";
                    color: #c7d0dc;
                    font-size: 13px;
                }

                LineEdit {
                    x: 160px;
                    y: 336px;
                    width: parent.width - 160px;
                    height: 34px;
                    text <=> root.launcher-asteroid-probability-text;
                    placeholder-text: "20.0";
                    accepted => {
                        root.launcher-start-game();
                    }
                }

                Text {
                    x: 0px;
                    y: 391px;
                    text: "Player Health";
                    color: #c7d0dc;
                    font-size: 13px;
                }

                LineEdit {
                    x: 160px;
                    y: 384px;
                    width: parent.width - 160px;
                    height: 34px;
                    text <=> root.launcher-player-health-text;
                    placeholder-text: "100";
                    accepted => {
                        root.launcher-start-game();
                    }
                }

                Text {
                    x: 0px;
                    y: 432px;
                    width: parent.width;
                    text: root.launcher-error-text;
                    color: #ff6f6f;
                    font-size: 13px;
                }
            }

            Rectangle {
                visible: root.launcher-controls-visible;
                x: 24px;
                y: 100px;
                width: parent.width - 48px;
                height: 330px;
                background: #00000000;

                Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    text: "Player 1: W thrust, S reverse, A/D turn, J wings, Space laser, K cannon";
                    color: #e6edf7;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                Text {
                    x: 0px;
                    y: 54px;
                    width: parent.width;
                    text: "Player 2: Numpad 8 thrust, Numpad 5 reverse, Numpad 4/6 turn, PageDown wings, Delete laser, End cannon";
                    color: #e6edf7;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                Text {
                    x: 0px;
                    y: 126px;
                    width: parent.width;
                    text: "Global: P pause, R restart, B benchmark. Losing window focus clears held keys.";
                    color: #c7d0dc;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                Text {
                    x: 0px;
                    y: 190px;
                    width: parent.width;
                    text: "Wings use the original hold behavior: hold the wing key to close, release to open.";
                    color: #c7d0dc;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }

            Button {
                visible: !root.launcher-controls-visible;
                x: 24px;
                y: 522px;
                width: 140px;
                height: 36px;
                text: "Start Game";
                primary: true;
                clicked => {
                    root.launcher-start-game();
                }
            }

            Button {
                visible: !root.launcher-controls-visible;
                x: 174px;
                y: 522px;
                width: 150px;
                height: 36px;
                text: "Start Benchmark";
                clicked => {
                    root.launcher-start-benchmark();
                }
            }

            Button {
                visible: !root.launcher-controls-visible;
                x: 334px;
                y: 522px;
                width: 142px;
                height: 36px;
                text: "Controls";
                clicked => {
                    root.launcher-controls-visible = true;
                }
            }

            Button {
                visible: root.launcher-controls-visible;
                x: 24px;
                y: 456px;
                width: 140px;
                height: 36px;
                text: "Back";
                clicked => {
                    root.launcher-controls-visible = false;
                }
            }

            Button {
                x: parent.width - 164px;
                y: root.launcher-controls-visible ? 456px : 582px;
                width: 140px;
                height: 36px;
                text: "Quit";
                clicked => {
                    root.launcher-quit();
                }
            }
        }
    }
}
