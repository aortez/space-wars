// Both plots use a centered zero axis. Unit order stays fixed as the duck moves.
component SignedPlot inherits Rectangle {
    in property <string> heading;
    in property <string> first;
    in property <string> last;
    in property <[float]> values;
    in property <float> scale: 1;
    background: #0c1723; border-radius: 4px;

    Text {
        x: 8px; y: 3px; width: parent.width - 62px; height: 19px;
        text: root.heading; color: #dee8ef; font-size: 12px; font-weight: 600; overflow: elide;
    }
    Text {
        x: parent.width - 54px; y: 4px; width: 46px; height: 16px;
        text: root.scale < 0.001 ? "<0.001" : "±" + round(root.scale * 1000) / 1000;
        color: #9fb5c3; font-size: 10px; horizontal-alignment: right;
    }
    Rectangle {
        x: 8px; y: 26px; width: parent.width - 16px; height: max(4px, parent.height - 45px);
        background: #09111a; clip: true;
        Rectangle { x: 0px; y: parent.height * 0.5; width: parent.width; height: 1px; background: #78909d; }
        for value[index] in root.values: Rectangle {
            private property <float> unit: clamp(value / max(0.00000001,root.scale), -1, 1);
            x: index * parent.width / max(1,root.values.length);
            y: self.unit > 0 ? parent.height * (1 - self.unit) * 0.5 : parent.height * 0.5 + 1px;
            width: max(1px, parent.width / max(1,root.values.length) - 1px);
            height: self.unit == 0 ? 0px : max(1px, abs(self.unit) * (parent.height / 2 - 1px));
            background: self.unit >= 0 ? #65d5bb : #f1a073;
        }
    }
    Text {
        x: 8px; y: parent.height - 17px; width: parent.width * 0.47; height: 14px;
        text: root.first; color: #a3b7c8; font-size: 10px;
    }
    Text {
        x: parent.width * 0.48; y: parent.height - 17px; width: parent.width * 0.52 - 8px; height: 14px;
        text: root.last; color: #a3b7c8; font-size: 10px; horizontal-alignment: right;
    }
}

export component DuckBrainPanel inherits Rectangle {
    in property <string> identity;
    in property <string> action;
    in property <string> status;
    in property <image> polar;
    in property <[float]> units;
    in property <[float]> signal;
    in property <float> unit-scale: 1;
    in property <float> signal-scale: 1;
    private property <bool> wide: self.width > 620px;
    private property <length> body-top: self.wide ? 36px : 60px;
    private property <length> body-height: self.height - self.body-top - 25px;
    private property <length> map-width: self.wide ? min(190px, self.width * 0.23) : (self.width - 18px) * 0.46;
    private property <length> map-height: self.wide ? self.body-height : self.body-height * 0.52;
    background: #101e2b; border-radius: 6px;
    Text {
        x: 10px; y: 4px; width: root.wide ? parent.width * 0.35 : parent.width - 20px; height: 24px;
        text: root.identity + " brain  /  " + root.action; color: #eef4f6;
        font-size: root.wide ? 17px : 15px; font-weight: 600; vertical-alignment: center; overflow: elide;
    }
    Text {
        x: root.wide ? parent.width * 0.33 : 10px; y: root.wide ? 4px : 28px;
        width: root.wide ? parent.width * 0.67 - 10px : parent.width - 20px;
        height: root.wide ? 24px : 28px; vertical-alignment: center; horizontal-alignment: root.wide ? right : left;
        text: root.status; color: #bad0da; font-size: 11px; wrap: word-wrap; overflow: elide;
    }
    Rectangle {
        x: 7px; y: root.body-top; width: root.map-width; height: root.map-height; background: #0c1723; border-radius: 4px;
        Text { x: 7px; y: 3px; width: parent.width - 14px; height: 17px; text: "Polar senses"; font-size: 12px; font-weight: 600; color: #dee8ef; }
        Image { x: 3px; y: 21px; width: parent.width - 6px; height: parent.height - 39px; source: root.polar; image-fit: contain; }
        for label[index] in ["Terrain", "Goal", "Duck"]: Text {
            x: index * parent.width / 3; y: parent.height - 15px; width: parent.width / 3; height: 13px;
            text: label; color: [#7ddbe2, #ffc159, #eff8fa][index]; font-size: 10px;
            horizontal-alignment: center;
        }
    }
    SignedPlot {
        x: root.wide ? root.map-width + 13px : 7px;
        y: root.wide ? root.body-top : root.body-top + root.map-height + 5px;
        width: root.wide ? (parent.width - root.map-width - 25px) * 0.62 : parent.width - 14px;
        height: root.wide ? root.body-height : root.body-height - root.map-height - 5px;
        heading: "64 unit contributions"; values: root.units; scale: root.unit-scale;
        first: "Unit 1"; last: "Unit 64";
    }
    SignedPlot {
        x: root.wide ? root.map-width + 18px + (parent.width - root.map-width - 25px) * 0.62 : root.map-width + 12px;
        y: root.body-top; width: parent.width - self.x - 7px; height: root.map-height;
        heading: "Output history"; values: root.signal; scale: root.signal-scale;
        first: "Earlier"; last: "Now";
    }
    Text {
        x: 10px; y: parent.height - 19px; width: parent.width - 20px; height: 16px;
        text: "Unit × weight · Teal positive · Orange negative · Midline zero";
        color: #b3c7d3; font-size: 10px; overflow: elide;
    }
}
