[Unit]
Description=Space-Wars kiosk
Requires=spacewars-data-init.service spacewars-hardware.service
Wants=spacewars-seatd.service
After=spacewars-data-init.service spacewars-hardware.service spacewars-seatd.service systemd-user-sessions.service

[Service]
Type=simple
User=spacewars
Group=spacewars
SupplementaryGroups=input video audio
Environment=SPACEWARS_CONFIG_DIR=/var/lib/spacewars
Environment=SLINT_BACKEND=linuxkms-software
EnvironmentFile=/run/spacewars-hardware/hardware.env
# Optional per-device overrides; the shared boot partition survives A/B updates.
EnvironmentFile=-/boot/spacewars-kiosk.env
WorkingDirectory=/data/spacewars
ExecStart=/usr/bin/engine-client --fullscreen --config-dir /var/lib/spacewars --renderer raster --raster-scale 2.0
Restart=on-failure
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
