From: Space-Wars maintainers <noreply@spacewars.local>
Subject: [PATCH] settings: retain version on identical non-persisted secret refresh

NetworkManager increments VersionId on every secrets callback, even when
normalization and the full comparison (including credentials) find the same
profile. Reconnecting then looks like an external settings edit to the radio
controller.

Suppress only the counter increment for an identical, non-persisted internal
agent-secret refresh with unchanged storage and flags. Preserve cache updates,
Updated notifications, explicit updates, secret changes, clear operations,
profile reloads and all other update reasons.

Upstream-Status: Pending
---
--- a/src/core/settings/nm-settings.c
+++ b/src/core/settings/nm-settings.c
@@ -1084,19 +1084,21 @@
     gs_unref_object NMSettingsConnection *sett_conn      = g_object_ref(sett_conn_entry->sett_conn);
     const char                           *path;
     gboolean                              is_new;
+    gboolean                              same_storage;
+    NMSettingsConnectionIntFlags          old_flags;
 
     nm_assert(!NM_FLAGS_ANY(sett_mask, ~_NM_SETTINGS_CONNECTION_INT_FLAGS_PERSISTENT_MASK));
     nm_assert(!NM_FLAGS_ANY(sett_flags, ~sett_mask));
 
-    is_new = c_list_is_empty(&sett_conn->_connections_lst);
-
-    _LOGT("update[%s]: %s connection \"%s\" (" NM_SETTINGS_STORAGE_PRINT_FMT "), "
-          "new version-id %" G_GUINT64_FORMAT,
+    is_new       = c_list_is_empty(&sett_conn->_connections_lst);
+    same_storage = nm_settings_connection_get_storage(sett_conn) == storage;
+    old_flags    = nm_settings_connection_get_flags(sett_conn);
+
+    _LOGT("update[%s]: %s connection \"%s\" (" NM_SETTINGS_STORAGE_PRINT_FMT ")",
           nm_settings_storage_get_uuid(storage),
           is_new ? "adding" : "updating",
           nm_connection_get_id(connection),
-          NM_SETTINGS_STORAGE_PRINT_ARG(storage),
-          (nm_settings_connection_get_version_id(sett_conn) + 1u));
+          NM_SETTINGS_STORAGE_PRINT_ARG(storage));
 
     _nm_settings_connection_set_storage(sett_conn, storage);
 
@@ -1168,7 +1170,17 @@
                                      path);
     }
 
-    nm_settings_connection_bump_version_id(sett_conn);
+    /* get_secrets_cb can refresh an identical profile without persisting it.
+     * Preserve the revision only for that exact internal operation. The full
+     * comparison above includes secrets; a credential change, new storage,
+     * changed flags, or any explicit update must still invalidate stale versions.
+     * Keep cache refreshes and Updated notifications even for the no-op case. */
+    if (is_new || connection_old || !same_storage
+        || old_flags != nm_settings_connection_get_flags(sett_conn)
+        || update_reason
+               != (NM_SETTINGS_CONNECTION_UPDATE_REASON_IGNORE_PERSIST_FAILURE
+                   | NM_SETTINGS_CONNECTION_UPDATE_REASON_RESET_AGENT_SECRETS))
+        nm_settings_connection_bump_version_id(sett_conn);
 
     if (is_new) {
         nm_dbus_object_emit_signal(NM_DBUS_OBJECT(self),
